{
  "manifest_version": 3,
  "name": "X Instagram Img DL NSFW",
  "version": "1.3.0",
  "description": "XとInstagramの投稿画像と動画サムネイルを投稿者IDを使ったファイル名で保存します。",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://pbs.twimg.com/*", "https://*.cdninstagram.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
    "js": ["instagram-core.js", "instagram-content.js"],
    "css": ["instagram-content.css"],
    "run_at": "document_idle"
  }]
}
